{
  "manifest_version": 3,
  "name": "AEGIS AI Web & Ad Shield",
  "version": "0.1.0",
  "author": "AegisVerse",
  "description": "AEGIS AI Security resmi tarayıcı kalkanı: Zararlı linkler, oltalama (phishing), sahte indirmeler, can sıkıcı reklamlar ve izinsiz açılan yeni pop-up sekmeleri anında engeller.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AEGIS AI Web Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_malware",
        "enabled": true,
        "path": "rules/malware.json"
      },
      {
        "id": "ruleset_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "ruleset_ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  }
}
